{
  "info": {
    "_postman_id": "d634bb7e-49f8-4adb-aef2-c4a3f88ffaf3",
    "name": "Spring Boot Demo - Redis API",
    "description": "Postman collection for Redis set/get/delete APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Set Redis Value",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"demo:key\",\n  \"value\": \"hello redis\",\n  \"ttlSeconds\": 60\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/redis",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "redis"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Redis Value",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/redis?key={{redisKey}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "redis"
          ],
          "query": [
            {
              "key": "key",
              "value": "{{redisKey}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Redis Value",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/redis?key={{redisKey}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "redis"
          ],
          "query": [
            {
              "key": "key",
              "value": "{{redisKey}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "redisKey",
      "value": "demo:key"
    }
  ]
}
